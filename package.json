{
  "name": "package-review-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static package whitelisting database and generated review reports",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "validate": "node scripts/validate.mjs",
    "check": "node scripts/check.mjs",
    "serve": "node scripts/serve.mjs",
    "review:prepare": "node scripts/prepare-request.mjs",
    "review:collect": "node scripts/collect.mjs",
    "review:verify": "node scripts/verify-review.mjs",
    "review:publish": "node scripts/publish-review.mjs",
    "review:suite": "node scripts/collect-suite.mjs",
    "review:verify-suite": "node scripts/verify-suite.mjs"
  },
  "engines": {
    "node": ">=20.11"
  }
}
